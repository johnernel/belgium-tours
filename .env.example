APP_NAME="Go Belgium Tours"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# XAMPP defaults (create the database first: see docs/reference/LOCAL_XAMPP.md)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gobelgium
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync locally. In production use "database" and run a queue worker (see DEPLOYMENT.md)
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Local mail: written to storage/logs/laravel.log. Use smtp + Mailpit if you prefer.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="enquiries@example.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# First admin account, created by `php artisan db:seed`. Change the password!
ADMIN_SEED_EMAIL=admin@example.test
ADMIN_SEED_PASSWORD=ChangeMe-Now-123

# Google reCAPTCHA v2 checkbox. These are Google's PUBLIC TEST keys (always pass).
# Replace with real keys in production (or set them in Admin > Settings).
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# GoHighLevel. Leave BOTH empty to switch the integration off. Never commit real values.
GHL_API_TOKEN=
GHL_LOCATION_ID=
